---
// Link externo com seta, sublinhado fixo (ex.: "Try it live").
interface Props {
  href: string;
  label: string;
}

const { href, label } = Astro.props;
const external = /^https?:/.test(href);
---

<a class="link-out" href={href} target={external ? "_blank" : undefined} rel={external ? "noopener noreferrer" : undefined}>
  <span>{label}</span>
  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <path
      d="M3 13L13 3M13 10.5V3H5.5"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </svg>
</a>

<style>
  .link-out {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: var(--space-inline-xs);
    color: var(--content-primary);
    font-size: var(--typo-label-md-size);
    font-weight: var(--typo-label-md-weight);
    line-height: var(--typo-label-md-line-height);
    letter-spacing: var(--typo-label-md-letter-spacing);
    text-decoration: none;
    border-bottom: 1px solid var(--border-inverse);
  }

  .link-out svg {
    transition: transform var(--duration-base) var(--ease-standard);
  }

  .link-out:hover svg,
  .link-out:focus-visible svg {
    transform: translate(2px, -2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .link-out svg {
      transition: none;
    }
  }
</style>
