---
/*
 * Comparação "antes e depois": as duas telas sobrepostas e um divisor que a
 * pessoa arrasta. O controle é um <input type="range"> invisível por cima das
 * imagens, então mouse, toque e teclado funcionam sem código extra. As duas
 * imagens precisam ter o mesmo tamanho.
 */
interface Props {
  /** Cada imagem tem seu próprio texto alternativo. */
  before: { src: string; alt: string };
  after: { src: string; alt: string };
  /** Valor anunciado pelo controle; "{value}" vira a posição do divisor. */
  valueText: string;
  width: number;
  height: number;
  /** Nome do controle para leitores de tela. */
  controlLabel: string;
  caption?: string;
}

const { before, after, valueText, width, height, controlLabel, caption } = Astro.props;
const valueAt = (value: string) => valueText.replace("{value}", value);
---

<figure class="compare">
  <div class="compare__frame" style="--position: 50%">
    <img class="compare__img" src={before.src} alt={before.alt} width={width} height={height} loading="lazy" decoding="async" />
    <img class="compare__img compare__img--after" src={after.src} alt={after.alt} width={width} height={height} loading="lazy" decoding="async" />
    <input class="compare__range" type="range" min="0" max="100" value="50" aria-label={controlLabel} aria-valuetext={valueAt("50")} data-value-text={valueText} />
    <span class="compare__divider" aria-hidden="true">
      <span class="compare__knob">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 7l-5 5 5 5M15 7l5 5-5 5" />
        </svg>
      </span>
    </span>
  </div>
  {caption && <figcaption class="case-caption">{caption}</figcaption>}
</figure>

<script>
  document.querySelectorAll<HTMLElement>(".compare__frame").forEach((frame) => {
    const range = frame.querySelector<HTMLInputElement>(".compare__range")!;
    const update = () => {
      frame.style.setProperty("--position", `${range.value}%`);
      range.setAttribute("aria-valuetext", range.dataset.valueText!.replace("{value}", range.value));
    };
    range.addEventListener("input", update);
    update(); // o navegador pode restaurar o valor ao voltar pelo histórico
  });
</script>

<style>
  .compare {
    display: flex;
    flex-direction: column;
    gap: var(--space-stack-sm);
    margin: 0;
  }

  .compare__frame {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    user-select: none;
  }

  .compare__img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* O "depois" fica por cima e aparece só à direita do divisor */
  .compare__img--after {
    position: absolute;
    inset: 0;
    clip-path: inset(0 0 0 var(--position));
  }

  .compare__range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    appearance: none;
    cursor: grab;
    /* No celular, arrastar na vertical continua rolando a página */
    touch-action: pan-y;
  }

  /* Enquanto arrasta, a mão se fecha */
  .compare__range:active {
    cursor: grabbing;
  }

  /* Alça nativa quase sem largura: o divisor fica exatamente sob o ponteiro */
  .compare__range::-webkit-slider-thumb {
    width: 2px;
    height: 100vh;
    appearance: none;
    cursor: inherit;
  }

  .compare__range::-moz-range-thumb {
    width: 2px;
    height: 100vh;
    border: 0;
  }

  .compare__divider {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--position);
    width: 2px;
    background: var(--surface-inverse);
    transform: translateX(-50%);
    pointer-events: none;
  }

  .compare__knob {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    color: var(--surface-default);
    background: var(--surface-inverse);
    border-radius: 50%;
    transform: translate(-50%, -50%);
  }

  .compare__range:focus-visible + .compare__divider .compare__knob {
    outline: 2px solid var(--border-accent-default);
    outline-offset: 2px;
  }
</style>
