---
// Linha do processo: etapa à esquerda, título + texto à direita.
// O que vier dentro da tag (ex.: uma imagem) fica abaixo do texto, antes do filete.
interface Props {
  label: string;
  title: string;
  text: string;
  // Lista em tópicos abaixo do texto. "destaque: descrição" põe o destaque em negrito
  items?: string[];
  // Parágrafo de fechamento, depois da lista
  after?: string;
  // Última etapa do Processo: sem o filete de baixo
  final?: boolean;
}

const { label, title, text, items, after, final } = Astro.props;
---

<div class:list={["step", { "step--media": Astro.slots.has("default"), "step--final": final }]}>
  <div class="step__row">
    <p class="case-label">{label}</p>
    <div class="step__body">
      <h3>{title}</h3>
      <p>{text}</p>
      {
        items && (
          <ul class="step__list">
            {items.map((item) => {
              const [lead, ...rest] = item.split(": ");
              return (
                <li>
                  <strong>{lead}</strong>
                  {rest.length > 0 && `: ${rest.join(": ")}`}
                </li>
              );
            })}
          </ul>
        )
      }
      {after && <p>{after}</p>}
    </div>
  </div>
  <slot />
  {!final && <span class="rule rule--bottom" data-rule aria-hidden="true"></span>}
</div>

<style>
  .step {
    display: flex;
    flex-direction: column;
    gap: var(--space-stack-xl);
    padding-bottom: var(--space-inset-lg);
    position: relative;
  }

  /* Com imagem, o filete ganha mais respiro */
  .step--media {
    padding-bottom: var(--space-inset-3xl);
  }

  .step--final {
    padding-bottom: 0;
  }

  .step__row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-inline-md);
  }

  .step__body {
    display: flex;
    /* Parte de 500px e encolhe quando a coluna não comporta rótulo + texto */
    flex: 0 1 500px;
    flex-direction: column;
    gap: var(--space-stack-md);
    min-width: 0;
  }

  .step__row > .case-label {
    flex: none;
  }

  .step__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-stack-xs);
    margin: 0;
    padding-left: var(--spacing-24);
  }

  .step__list strong {
    font-weight: var(--typo-body-md-semibold-weight);
  }

  @media (max-width: 599.98px) {
    .step__row {
      flex-direction: column;
    }

    /* Empilhado, a base de 500px viraria altura */
    .step__body {
      flex-basis: auto;
      width: 100%;
    }
  }
</style>
