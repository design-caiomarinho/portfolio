---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

// O Cloudflare Pages serve este arquivo (404.html) em qualquer endereço inexistente.
// Não dá para saber o idioma aqui, então a página é só em inglês.
---

<Base title="Page not found — Caio Marinho" description="This page does not exist.">
  <Header />
  <main class="notfound">
    <h1 class="notfound__title">Page not found</h1>
    <p class="notfound__text">The page you are looking for does not exist or has moved.</p>
    <a class="notfound__link" href="/">Back to home</a>
  </main>
  <Footer />
</Base>

<style>
  .notfound {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: var(--space-stack-xs);
    min-height: 450px;
    padding: var(--space-inset-xl);
  }

  .notfound__title {
    font-family: var(--typo-heading-lg-family);
    font-size: var(--typo-heading-lg-size);
    font-weight: var(--typo-heading-lg-weight);
    line-height: var(--typo-heading-lg-line-height);
    letter-spacing: var(--typo-heading-lg-letter-spacing);
    color: var(--content-primary);
    margin: 0;
  }

  .notfound__text {
    font-family: var(--typo-body-md-regular-family);
    font-size: var(--typo-body-md-regular-size);
    font-weight: var(--typo-body-md-regular-weight);
    line-height: var(--typo-body-md-regular-line-height);
    letter-spacing: var(--typo-body-md-regular-letter-spacing);
    color: var(--content-secondary);
  }

  .notfound__link {
    margin-top: var(--space-stack-md);
    color: var(--content-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
